generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ApiRequestLog {
  id           BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  operationId  String
  requestPath  String
  queryParams  Json
  requestedAt  DateTime         @default(now())
  completedAt  DateTime?
  status       ApiRequestStatus @default(RUNNING)
  error        String?
  responseSize Int?

  @@index([operationId, requestedAt])
  @@index([status, requestedAt])
}

model ClinicmindsSyncRun {
  id           BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  entityKey    String
  operationId  String
  requestPath  String
  requestParams Json
  startedAt    DateTime               @default(now())
  completedAt  DateTime?
  status       ClinicmindsSyncStatus  @default(RUNNING)
  error        String?
  fetchedCount Int                    @default(0)
  storedCount  Int                    @default(0)
  rawRecords   ClinicmindsRawRecord[]

  @@index([entityKey, startedAt])
  @@index([status, startedAt])
}

model ClinicmindsRawRecord {
  id           BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  syncRunId    BigInt             @db.UnsignedBigInt
  entityKey    String
  externalId   String?
  updateNeeded Boolean            @default(false)
  rowIndex     Int
  payload      Json
  fetchedAt    DateTime           @default(now())
  syncRun      ClinicmindsSyncRun @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@unique([syncRunId, rowIndex])
  @@index([entityKey])
  @@index([entityKey, updateNeeded])
}

enum ApiRequestStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum ClinicmindsSyncStatus {
  RUNNING
  SUCCEEDED
  FAILED
}
