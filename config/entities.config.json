[
  {
    "key": "cmPatient",
    "label": "CM Patient",
    "endpoint": "/api/analytics/patients",
    "targetTable": "cm_patient",
    "cron": "30 2 * * *",
    "mode": "full_replace",
    "externalIdField": "patientNumber",
    "readStrategy": "full_replace",
    "filtersFromSpec": [
      "format",
      "date_from",
      "date_to"
    ],
    "notes": "Patient analytics extract from Clinicminds. Because the API date filters use initial registration date rather than change date, patient sync should run as a full daily replace.",
