@baseUrl = http://localhost:3020
@onlineBookingsDateFrom = 2026-07-01
@onlineBookingsDateTo = 2026-07-07
@onlineBookingsFormat = json
@onlineBookingsSaveLog = true
@onlineBookingsSyncRunsLimit = 20
@onlineBookingsRawLimit = 20

### Online bookings request with editable filters
GET {{baseUrl}}/clinicminds/online-bookings?date_from={{onlineBookingsDateFrom}}&date_to={{onlineBookingsDateTo}}&date2_from={{onlineBookingsDateFrom}}&date2_to={{onlineBookingsDateTo}}&format={{onlineBookingsFormat}}&saveLog={{onlineBookingsSaveLog}}
Accept: application/json

### Run online bookings sync with default date-window logic
POST {{baseUrl}}/clinicminds/sync/cmOnlineBooking
Content-Type: application/json
Accept: application/json

{
  "format": "{{onlineBookingsFormat}}",
  "saveRequestLog": true
}

### Run online bookings sync with explicit filters
POST {{baseUrl}}/clinicminds/sync/cmOnlineBooking
Content-Type: application/json
Accept: application/json

{
  "format": "{{onlineBookingsFormat}}",
  "saveRequestLog": true,
  "params": {
    "date_from": "{{onlineBookingsDateFrom}}",
    "date_to": "{{onlineBookingsDateTo}}",
    "date2_from": "{{onlineBookingsDateFrom}}",
    "date2_to": "{{onlineBookingsDateTo}}"
  }
}

### List online booking sync runs
GET {{baseUrl}}/clinicminds/sync/runs?entityKey=cmOnlineBooking&limit={{onlineBookingsSyncRunsLimit}}
Accept: application/json

### List online booking raw rows
GET {{baseUrl}}/clinicminds/raw?entityKey=cmOnlineBooking&limit={{onlineBookingsRawLimit}}
Accept: application/json

### List online booking raw rows that need update
GET {{baseUrl}}/clinicminds/raw?entityKey=cmOnlineBooking&updateNeeded=true&limit={{onlineBookingsRawLimit}}
Accept: application/json
