    "rawTableIndexes": [
      [
        "entityKey"
      ],
      [
        "entityKey",
        "stagingStatus"
      ]
    ],
    "normalizedIndexes": [
      [
        "patientNumber"
      ],
      [
        "lastName",
        "firstName",
        "dateOfBirth"
      ]
    ]
  },
